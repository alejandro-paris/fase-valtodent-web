---
import Icon from '../Icon.astro';
import { DENTAL, HEALTH } from '../../site';

const groups = [
  { title: 'Clínica dental', items: DENTAL },
  { title: 'Más especialidades', items: HEALTH },
];
---

<section id="especialidades" class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
  <div class="max-w-2xl" data-reveal>
    <p class="font-display text-xs font-semibold tracking-[0.18em] text-hoja uppercase">Especialidades</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-[2.75rem] md:leading-tight">
      Todo lo que necesitas, en una sola clínica
    </h2>
  </div>

  {
    groups.map((group) => (
      <div class="mt-12">
        <h3 class="mb-5 flex items-center gap-3 text-lg font-semibold text-grafito/80" data-reveal>
          <span class="h-px w-8 bg-salvia" aria-hidden="true" />
          {group.title}
        </h3>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {group.items.map((item) => (
            <li class="group rounded-3xl border border-grafito/8 bg-white p-6 transition-shadow hover:shadow-[0_18px_40px_-28px_rgba(43,47,42,.5)]" data-reveal>
              <span class="grid size-12 place-items-center rounded-2xl bg-niebla text-hoja transition-colors group-hover:bg-salvia group-hover:text-hoja-deep">
                <Icon name={item.icon} class="size-6" />
              </span>
              <h4 class="mt-4 font-display text-lg font-semibold">{item.title}</h4>
              <p class="mt-1.5 leading-relaxed text-grafito/70">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
