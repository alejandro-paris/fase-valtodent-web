---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import Icon from './Icon.astro';
import { NAV, SITE } from '../site';
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-transparent bg-papel/90 backdrop-blur transition-[border-color,box-shadow] data-[scrolled]:border-grafito/10 data-[scrolled]:shadow-[0_6px_24px_-18px_rgba(43,47,42,.5)]"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:h-20 md:px-6">
    <a href={import.meta.env.BASE_URL.replace(/\/?$/, '/')} class="shrink-0" aria-label={`${SITE.name}, inicio`}>
      <Image src={logo} alt={SITE.name} class="h-7 w-auto md:h-9" loading="eager" />
    </a>
    <nav class="hidden items-center gap-8 font-display text-[15px] font-medium text-grafito/80 md:flex" aria-label="Principal">
      {NAV.map((item) => <a href={item.href} class="transition-colors hover:text-hoja">{item.label}</a>)}
    </nav>
    <a
      href={`tel:${SITE.phone}`}
      class="inline-flex items-center gap-2 rounded-full bg-hoja px-4 py-2.5 font-display text-sm font-semibold text-white transition-colors hover:bg-hoja-deep md:px-5"
    >
      <Icon name="phone" class="size-4" />
      <span>Pedir cita</span>
    </a>
  </div>
</header>
