---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
// BASE_URL puede venir sin barra final (p. ej. /fase-valtodent-web).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {SITE.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <script is:inline>
      // Activa las animaciones antes del primer pintado. Sin JS o con movimiento reducido,
      // la página se muestra estática y completa.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
